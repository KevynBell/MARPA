[Unit]
Description=MARPA Local AI Assistant
After=network-online.target ollama.service
Wants=network-online.target
Requires=ollama.service

[Service]
Type=simple
User=marpa
Group=marpa

WorkingDirectory=/home/marpa/projects/MARPA
Environment=PYTHONUNBUFFERED=1

ExecStart=/home/marpa/projects/MARPA/.venv/bin/python /home/marpa/projects/MARPA/src/marpa_server.py

Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
